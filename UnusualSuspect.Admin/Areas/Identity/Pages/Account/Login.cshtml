@page
@model LoginModel
@inject ISoftSettingService _softSettingService
@{
    ViewData["Title"] = "صفحه ورود پنل مدیریت";
    var MiscOB = _softSettingService.GetSoftSetting();
}
<div class="container">

    <div class="row">
        <div class="col-sm-4"></div>
        <div class="col-sm-4">
            <section>
                <div class="login-logo">
                    <a asp-action="Index" asp-controller="Home" asp-area="">
                        @*<img src="@MiscOB.MainLogo" />*@
                    </a>
                </div>
                <form id="loginform" method="post" class="login-form" >
                    <div class="form-horizontal">
                        <h5>ورود به @MiscOB.SmallTitle</h5>
                        <hr />
                        <div>
                            <a class="phonenumber-validation text-info pb-4 heartBeat hide" data-delay="1s"><span class="fa fa-long-arrow-left"></span>اعتبارسنجی شماره همراه</a>
                        </div>
                        <div class="form-group">
                            <label for="Input_PhoneNumber">نام کاربری یا شماره همراه</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group row no-gutters">
                            <div class="col-md-12">
                                <label for="Input_Password">رمز عبور</label>
                                <a id="forgot-password" asp-page="./ForgotPassword">رمز عبور خود را خود را فراموش کردید ؟</a>
                            </div>
                            <div class="col-md-12">
                                <input asp-for="Input.Password" class="form-control" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="checkbox">
                                <label asp-for="Input.RememberMe">
                                    <input asp-for="Input.RememberMe" />
                                    مرا به خاطر بسپار
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-login">ورود</button>
                        </div>
                    </div>
                   
                </form>
            </section>
        </div>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            $('#loginform').bootstrapValidator({
                live: 'submitted',
                feedbackIcons: {
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'Input.PhoneNumber': {
                        validators: {
                            notEmpty: {
                            }
                        }
                    },
                    "Input.Password": {
                        validators: {
                            notEmpty: {

                            },
                            stringLength: {
                                min: 6
                            }
                        }
                    }
                }
            }).on('success.form.bv', function (e) {
                e.preventDefault();
                var $form = $(e.target);
                var formData = new FormData(this);
                var bv = $form.data('bootstrapValidator');
                jQuery.ajaxSettings.traditional = true;
                $.ajax({
                    beforeSend: function () {
                        $form.addClass("DisableItems");
                    },
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: formData,
                    success: function (result) {
                        console.log(result);
                        if (result.Success) {
                            window.location.href = result.Url;
                        }
                        else {
                           
                            $("button[type='submit']").prop('disabled', false);
                            toastr.error(result.MessageList, '', { positionClass: "toast-bottom-center" });
                            $form.removeClass("DisableItems");
                        }
                    },
                    cache: false,
                    contentType: false,
                    processData: false
                });
            });
        });
    </script>
}
