@page
@inject ISoftSettingService softSettingService;

@model ForgetPasswordConfrimCode
@{

    ViewData["Title"] = "تائید کد امنیتی";
    var MiscOB = softSettingService.GetSoftSetting();
}
    <div class="container">

        <div class="row">
            <div class="col-md-offset-4 col-md-4">
                <section>
                    <div class="login-logo">
                        <a asp-action="Index" asp-controller="Home" asp-area="">
                            @*<img src="@MiscOB.MainLogo" />*@
                        </a>
                    </div>
                    <form method="post" id="forget-password-form" class="bg-light shadow-sm p-3">
                        <input asp-for="Input.PhoneNumber" type="hidden" />
                        <div class="form-horizontal">
                            <h4 class="text-center mb-3">فراموشی رمز عبور</h4>
                            <div class="alert alert-success text-dark text-justify ">
                                لطفا کدی را که از طریق پیامک به شماره همراه تان ارسال شده را وارد نمایید .
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.Code"></label>
                                <input asp-for="Input.Code" class="form-control text-center font-weight-bold" placeholder=" - - - - " />
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-success w-100">تائید کد</button>
                            </div>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>

    @section scripts{

        <script type="text/javascript">
            $(document).ready(function () {
                $('#forget-password-form').bootstrapValidator({
                    live: 'enable',
                    feedbackIcons: {
                        validating: 'glyphicon glyphicon-refresh'
                    },
                    fields: {
                        'Input.Code': {
                            validators: {
                                notEmpty: {
                                }
                            }
                        }
                    }
                }).on('success.form.bv', function (e) {
                    e.preventDefault();
                    var $form = $(e.target);
                    var formData = new FormData(this);
                    var bv = $form.data('bootstrapValidator');
                    jQuery.ajaxSettings.traditional = true;
                    $.ajax({
                        beforeSend: function () {
                            $form.addClass("DisableItems");
                        },
                        url: $form.attr("action"),
                        type: $form.attr("method"),
                        data: formData,
                        success: function (result) {
                            console.log(result);
                            if (result.Success) {
                                window.location.href = result.url;
                            }
                            else {
                                $("button[type='submit']").prop('disabled', false);
                                toastr.error(result.MessageList, '', { positionClass: "toast-bottom-center" });
                                $form.removeClass("DisableItems");
                            }
                        },
                        cache: false,
                        contentType: false,
                        processData: false
                    });
                });
            });
        </script>
    }
