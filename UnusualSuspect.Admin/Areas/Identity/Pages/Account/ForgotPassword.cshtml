@page
@inject ISoftSettingService softSettingService;

@model ForgotPasswordModel
@{

    ViewData["Title"] = "رمز عبور خود را فراموش کرده اید ؟";
    var MiscOB = softSettingService.GetSoftSetting();
}

<div class="container">

    <div class="row">
        <div class="col-md-offset-4 col-md-4">
            <section>
                <div class="login-logo">
                    <a asp-action="Index" asp-controller="Home" asp-area="">
                        @*<img src="@MiscOB.MainLogo" />*@
                    </a>
                </div>
                <form method="post" id="forget-password-form" class="bg-light shadow-sm p-3">
                    <div class="form-horizontal">
                        <h4 class="text-center mb-3">فراموشی رمز عبور</h4>
                        <div class="alert alert-warning text-dark text-justify ">لطفا شماره همراهی که با آن ثبت نام کرده اید را وارد نمایید .ما کدی را به شماره همراه شما جهت تغییر رمز عبور تان ارسال میکنیم. </div>
                        <div class="form-group">
                            <label asp-for="Input.PhoneNumber"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" />
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary w-100">ارسال کد</button>
                        </div>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            $('#forget-password-form').bootstrapValidator({
                live: 'enable',
                feedbackIcons: {
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'Input.PhoneNumber': {
                        validators: {
                            notEmpty: {
                            },
                            regexp: {
                                regexp: /(0|\+98)?([ ]|-|[()]){0,2}9[0|1|2|3|4|9]([ ]|-|[()]){0,2}(?:[0-9]([ ]|-|[()]){0,2}){8}/i,
                                message: "لطفا شماره موبایل معتبر وارد نمائید"
                            }
                        }
                    }
                }
            }).on('success.form.bv', function (e) {
                e.preventDefault();
                var $form = $(e.target);
                var formData = new FormData(this);
                var bv = $form.data('bootstrapValidator');
                jQuery.ajaxSettings.traditional = true;
                $.ajax({
                    beforeSend: function () {
                        $form.addClass("DisableItems");
                    },
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: formData,
                    success: function (result) {
                        if (result.Success) {
                            window.location.href = result.url;
                        }
                        else {
                            $("button[type='submit']").prop('disabled', false);
                            toastr.error(result.MessageList, '', { positionClass: "toast-bottom-center" });
                            $form.removeClass("DisableItems");
                        }
                    },
                    cache: false,
                    contentType: false,
                    processData: false
                });
            });
        });
    </script>
}
