    <script src="~/js/Kendo/kendo.timezones.min.js"></script>
    <script src="~/js/Kendo/messages/kendo.messages.fa-IR.min.js"></script>

    <!-- Persiandate -->
    <script src="~/js/anyresolver/anyresolver.date.js"></script>
    <script src="~/js/anyresolver/anyresolver.persiandate.js"></script>
    <script src="~/js/Persiandate.js"></script>
