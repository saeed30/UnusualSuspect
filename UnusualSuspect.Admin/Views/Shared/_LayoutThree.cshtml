<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dolat Mart</title>

    <link rel="stylesheet" href="~/asset/bootstrap-5.1.3-dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/asset/fontawesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/asset/fonts/jco-icon/00-feather-iconly-straight-streamline/feather-iconly-straight-streamline/css/jco-icon-embedded.css">
    <link href="~/vendor/toastr/toastr.min.css" rel="stylesheet" />

    <link href="~/css/BootstrapValidator.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/asset/swiper/swiper.css">
    <link href="~/asset/swiper/swiper.css" rel="stylesheet" />

    <link href="~/js/sweetalert.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/asset/css/style.css" asp-append-version="true">



</head>

<body>

    <header>
        <div class="container-xxl p-0">
            <nav class="navbar navbar-expand-lg px-xl-5 py-2 py-lg-0">
                <div class="container-fluid">
                    <a class="navbar-brand" href="/">
                        @*<img src=@Url.Content("/asset/img/logo.svg") alt="img">*@
                        انبوه سازان
                    </a>
                    <button class="navbar-toggler" type="button">
                        <span></span>
                        <span></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <form class="d-flex d-lg-none me-lg-5">
                            <span class="icon-feather-search"></span>
                            <input type="search" placeholder="جستجو در DOLATMART.COM" aria-label="Search">
                        </form>

                        @*@await Html.PartialAsync("_MenuItems")*@

                    </div>
                 
                </div>
            </nav>
          
        </div>
    </header>
    <div class="search-overlay"></div>

    <main>
        @RenderBody()
    </main>

    <!--<footer>-->
    @*@await Html.PartialAsync("_Footer")*@

    <!--</footer>-->


    <script src="~/asset/jquery/jquery.js"></script>
    <script src="~/asset/popper/popper-v2-11-2.js"></script>
    <script src="~/asset/bootstrap-5.1.3-dist/js/bootstrap.min.js"></script>
    <script src="~/lib/bootstrapvalidator/js/bootstrapValidator.js"></script>
    <script src="~/vendor/bootstrapvalidator/js/language/fa_IR.js"></script>
    <script src="~/js/sweetalert.min.js"></script> 
    <script src="~/vendor/toastr/toastr.min.js"></script>
    <script src="~/asset/swiper/swiper.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="~/asset/js/index.js" asp-append-version="true"></script>
    <script src="~/js/CustomJavaScript.js" asp-append-version="true"></script>

    <script src="~/asset/js/ManageShoppingCart.js"></script>
    @await RenderSectionAsync("scripts", required: false)

    <script>
        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
</body>

</html>