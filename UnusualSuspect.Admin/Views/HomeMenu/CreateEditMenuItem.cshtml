@model HomeMenu

    <script src="~/vendor/tinymce/tinymce.min.js"></script>


    <div class="modal-header" id="kt_modal_add_user_header">
        <h2 class="fw-bolder">@ViewBag.Title </h2>
        <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal" data-kt-users-modal-action="close">

            <span class="svg-icon svg-icon-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black"></rect>
                    <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black"></rect>
                </svg>
            </span>
        </div>
    </div>

    @using (Html.BeginForm("CreateEditMenuItem", "HomeMenu", FormMethod.Post, new { id = "CreateEditMenuItemForm", @class = "form-horizontal", enctype = "multipart/form-data" }))
    {
        <div class="modal-body scroll-y">

            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)

            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">عنوان</label>
                <div class="col-md-9">
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control", autocomplete = "off" })
                </div>
            </div>

            <div class="form-group row no-gutters Link-holder">
                <label class="control-label col-md-3">لینک</label>
                <div class="col-md-9">
                    @Html.TextBoxFor(model => model.Link, new { @class = "form-control", autocomplete = "off" })
                </div>
            </div>

            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">اولویت</label>
                <div class="col-md-9">
                    @Html.TextBoxFor(model => model.Priority, new { Type = "number", @class = "form-control", autocomplete = "off" })
                </div>
            </div>

            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">متن</label>
                <div class="col-md-9">
                    <a href="#" class="addTextBtn">
                        <i class="fa fa-plus"></i>
                        <span>افزودن متن</span>
                    </a>
                    <div class="text-holder close">
                        @Html.EditorFor(model => model.Text, new { htmlAttributes = new { @class = "form-control" }, })
                    </div>
                </div>
            </div>

        </div>



        <div class="modal-footer no-gutters" style="padding-right:32px;">
            <div class="col-md-9 ">
                <button id="EditItemBtn" type="submit" class="btn btn-primary">ذخیره</button>
                <button id="test" type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
            </div>
        </div>


    }



    <script type="text/javascript">
        $(document).ready(function () {
            RenderTinyMce("#Text", null, "fa_IR");
            $('#CreateEditMenuItemForm').bootstrapValidator({
                live: 'enabled',
                feedbackIcons: {
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {
                    'Title': {
                        validators: {
                            notEmpty: {
                            }
                        }
                    },
                    'Link': {
                        validators: {
                            uri: {
                            }
                        }
                    }
                },
            }).on('success.form.bv', function (e) {
                e.preventDefault();
                var $form = $(e.target);
                var formData = new FormData(this);
                var bv = $form.data('bootstrapValidator');
                jQuery.ajaxSettings.traditional = true;

                $.ajax({
                    beforeSend: function () {
                        $form.addClass("DisableItems");
                    },
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: formData,
                    success: function (result) {
                        if (result.Success) {
                            toastr.success(result.MessageList, '', { positionClass: "toast-bottom-center" });
                            $("#grid").data("kendoGrid").dataSource.read();

                            $('#ModalDiv').modal('hide');


                            $('#grid').data('kendoGrid').dataSource.read().then(function () {
                                var dataGrid = $('#grid').data('kendoGrid');
                                let dataView = dataGrid.dataSource.view();

                                for (let i = 0; i < dataView.length; i++) {

                                    if (dataView[i].Id == result.Id) {

                                        dataGrid.table.find("tr[data-uid='" + dataView[i].uid + "']").addClass("alert-success-row");
                                    }
                                }
                            });

                        }
                        else {
                            $("button[type='submit']").prop('disabled', false);
                            toastr.error(result.MessageList, '', { positionClass: "toast-bottom-center" });
                            $form.removeClass("DisableItems");
                        }
                    },
                    cache: false,
                    contentType: false,
                    processData: false
                });
            });
        });



        //add text

        $('.addTextBtn').on('click', function () {
            if ($('.text-holder').is('.close')) {
                //$('.text-holder').css('display', 'block');
                $('.text-holder').toggle();
                $('.Link-holder').css('display', 'none');
                //$(this).find('span').text('بستن متن');
                $('.addTextBtn span').text('بستن متن');
                $('.addTextBtn i').removeClass('fa-plus').addClass('fa-times');
                $('.text-holder').removeClass('close');
            } else {
                //$('.text-holder').css('display', 'block');
                $('.text-holder').toggle();
                $('.Link-holder').css('display', 'flex');
                //$(this).find('span').text('بستن متن');
                $('.addTextBtn span').text('افزودن متن');
                $('.addTextBtn i').addClass('fa-plus').removeClass('fa-times');
                $('.text-holder').addClass('close');
            }
        });

    </script>
