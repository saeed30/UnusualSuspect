@using UnusualSuspect.Entities.GameModels
@{
  ViewBag.Title = "بازی های فعال";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="toolbar" id="kt_toolbar">
  <div class="container-fluid d-flex flex-stack">
    <div class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
      <h1 class="d-flex align-items-center text-dark fw-bolder fs-3 my-1">@(ViewBag.Title)</h1>
    </div>
    <div class="d-flex align-items-center py-1">
    </div>
  </div>
</div>
<div class="card card-flush">
  <div class="card-body">
    @(Html.Kendo().Grid<CharacterCard>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Id).Title("شناسه");
        columns.Bound(c => c.Title).Title("عنوان");
          columns.Bound(c => c.IsActive).Title("فعال")
            .ClientTemplate("<input type='checkbox' #= IsActive ? checked='checked' : '' # disabled='disabled' />");
          columns.Bound(c => c.ImageUrl).Title("آدرس تصویر");
          columns.Bound(c => c.ImageFile).Title("تصویر");
        columns.Command(command =>
        {
          command.Edit();
          command.Destroy();
          }).Title(" ").Width(200);
      })
      .ToolBar(toolbar => toolbar.Create())
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable(pager => pager
        .Input(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
      )
      .Filterable().Sortable()
      .DataSource(dataSource => dataSource
        .Custom()
        .PageSize(20)
        .Transport(model =>
        model
        .Read(read => read.Action("Character_Read", "Character"))
        .Create(read => read.Action("Character_Create", "Character").Type(HttpVerbs.Post))
        .Update(read => read.Action("Character_Update", "Character").Type(HttpVerbs.Post))
        .Destroy(read => read.Action("Character_Destroy", "Character").Type(HttpVerbs.Post))
        ).Schema(schema => schema
          .Data("Data")
          .Model(model => {
            model.Id(p => p.Id);
            model.Field(p => p.ImageFile).Editable(true); // Make ImageFile editable
            model.Field(p => p.ImageUrl).Editable(false); // Make ImageUrl not editable
          })
        )
        ).HtmlAttributes(new { enctype = "multipart/form-data" }))
  </div>
</div>