@{
    ViewBag.Title = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="toolbar" id="kt_toolbar">
    <div class="container-fluid d-flex flex-stack">
        <div class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
            <h1 class="d-flex align-items-center text-dark fw-bolder fs-3 my-1">@ViewBag.Title</h1>
        </div>
        <div class="d-flex align-items-center py-1">           
        </div>
    </div>
</div>


<div class="card card-flush">
    <div class="card-body">
        @(Html.Kendo().Grid<UsersInRoleViewModel>()
    .Name("grid")
    .Columns(columns =>
    {
        //columns.Bound(c => c.PatchImage).ClientTemplate("# if(ApplicationUser.PatchImage==null){ #  #}else{# <img src='/media/UserImage/#=ApplicationUser.PatchImage#'  width='40'/>#}#").Title("تصویر کاربر");
        columns.Bound(c => c.UserId).Title("کد کاربر");
        columns.Bound(c => c.FirstName).Title("نام");
        columns.Bound(c => c.LastName).Title("نام خانوادگی");
        columns.Bound(c => c.RoleNamesFa).Title("نقش ");
        columns.Bound(c => c.PhoneNumber).Title("شماره همراه");
        columns.Bound(c => c.NickName).Title("نام مستعار");
        columns.Bound(c => c.IsActive).Title("فعال");
        columns.Bound(c => c.AvatarId).Title("کد آواتار");
        columns.Bound(c => c.DocumentGuid).Title("کد تصویر");

        //columns.Bound(p => p.Id).ClientTemplate("<a class='k-button k-button-icontext' href='/AccessManagement/EditAccess?UserName=#=ApplicationUser.UserName#&SoftSectionId=1'><i class='fas fa-bolt text-primary'></i></a>").Title(" ").Filterable(false).Width(50);
        columns.Bound(p => p.UserId).ClientTemplate("<button type='button' class='k-button k-button-icontext EditItem' data-id='#=UserId#' data-type='0' data-remote='/ApplicationUser/CreateCustomerUser?UserId=#=UserId#'><i class='fas fa-edit text-primary'></i></button>").Title(" ").Filterable(false).Width(50);
        columns.Bound(p => p.UserId).ClientTemplate("<button  data-id='#=UserId#' type='button' class='k-button k-button-icontext DeleteItem' data-action='/ApplicationUser/DeleteCustomerUser' data-titlesweet='آیا مطمئن هستید' data-textsweet='در صورت اطمینان از حذف کاربر بر روی تائید کلیک کنید.' , SharedLocalizer['آیتم]' data-cancelbtn='انصراف' data-confirmbtn='تائید'><i class='fas fa-trash-alt text-danger'></i></button>").Title(" ").Filterable(false).Width(50);

    })
    .ToolBar(toolbar =>
    {
        toolbar.ClientTemplateId("GridToolbarTemplate");
    })
    .Pageable(pager => pager
            .Input(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
          )
    .Filterable().Sortable()
    .DataSource(dataSource => dataSource
    .Ajax().Sort(a => a.Add("UserId").Descending())
    .PageSize(20)
    .Model(model =>
    {
        model.Id(p => p.UserId);

    })
        .Read(read => read.Action("RegisterApplicationUser_read", "ApplicationUser"))
    ))
    </div>
</div>

<script id="GridToolbarTemplate" type="text/x-kendo-template">

     <div class="refreshBtnContainer">
        <a data-remote="/ApplicationUser/CreateCustomerUser" class="btn btn-success btn-create  w-content">
            <span class="k-icon k-i-add color-white"></span>
            ثبت کاربر جدید
        </a>
    </div>

</script>