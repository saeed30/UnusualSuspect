@model SoftwareRoleSearchViewModel

<form name="searchForm " id="searchForm" method="post" novalidate="novalidate">
    <div class="SearchForm">
        <label class="title-search">جستجو</label>
        <div class="row">

            <div class="col-md-10 col-sm-10">
                @Html.EditorFor(model => model.KeyWord, new { htmlAttributes = new { @class = "form-control", placeholder = "جستجو ..." }, })
            </div>

            <div class="col-md-2 col-sm-2 ">
                <button data-url="ShowAllSoftwareRoles_Read" type="submit" class="btn btn-primary SearchBtn"><i class="fa fa-search"></i> <span>جستجو </span> </button>
            </div>

        </div>
    </div>
</form>
