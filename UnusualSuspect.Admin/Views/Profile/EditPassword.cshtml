@model ApplicationUser

@{
    ViewBag.Title = "تغییر کلمه عبور";
}

<div class="toolbar" id="kt_toolbar">
    <div class="container-fluid d-flex flex-stack">
        <div class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
            <h1 class="d-flex align-items-center text-dark fw-bolder fs-3 my-1">@ViewBag.Title</h1>
        </div>
        <div class="d-flex align-items-center py-1">
        </div>
    </div>
</div>

<div class="card card-flush">
    <div class="card-body">
        @using (Html.BeginForm("EditPassword", "Profile", FormMethod.Post, new { id = "EditPasswordForm", dir = "rtl", enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(a => a.Id)


            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">کلمه عبور فعلی : </label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.OldPassword, new { htmlAttributes = new { @class = "form-control" }, })
                </div>
            </div>

            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">کلمه عبور جدید :</label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" }, })
                </div>
            </div>

            <div class="form-group row no-gutters">
                <label class="control-label col-md-3">تکرار کلمه عبور : </label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control" }, })
                </div>
            </div>

            <div class="form-group  row no-gutters">
                <div class="col-md-offset-3 col-md-6">
                    <button id="CreateItemBtn" type="submit" class="btn btn-primary">ثبت</button>
                </div>
            </div>
        }

    </div>
</div>
<script src="~/js/pages/profile/editpassword.js" type="text/javascript" />


