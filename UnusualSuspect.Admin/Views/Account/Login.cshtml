@model LoginViewModel
@inject ISoftSettingService _SoftSettingService;
@{
    var miscSettingOB = _SoftSettingService.GetSoftSetting();
    ViewBag.Title = $"سامانه {miscSettingOB.BussinessTitle}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سامانه عضویت</title>
    <link href="~/asset/bootstrap-5.1.3-dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/asset/fonts/jco-icon/01-feather/fontello-589df007/css/jco-feather-icon-embedded.css" rel="stylesheet" />
    <link href="~/asset/css/loginStyle/style.css" rel="stylesheet" />
    <link href="~/css/Kendo/web/kendo.rtl.min.css" rel="stylesheet" />
    <link href="~/css/BootstrapValidator.css" rel="stylesheet" />
    <link href="~/vendor/toastr/toastr.css" rel="stylesheet" />
    <link href="~/js/sweetalert.css" rel="stylesheet" />

    <style>
        .k-code-box {
            position: relative;
            z-index: 99;
        }
    </style>
</head>

<body>
    <div class="holder">
        <div class="container-xxl p-0 d-flex align-content-center">
            <div class="login w-100">
                <div class="row m-0 login-page d-flex">
                    <div class="col-lg-6">
                        <div class="right-sec">
                            <div class="col-sm-9 col-md-10 xol-lg-9 mx-auto">
                                <img src="~/images/imageicon.png" alt="">
                                <p class="title">پنل ورود به حساب کاربری</p>
                                <p class="describe">
                                    چنانچه پیش از این ثبت نام نموده اید با نام کاربری و کلمه عبور خود می توانید 
                                    وارد پنل خود شوید. چنانچه تا کنون ثبت نام نکرده جهت ثبت نام با مدیر سامانه ارتباط بر قرار کنید.
                                </p>
                            </div>
                            <div class="col-sm-7 xol-md-8 col-lg-7 mx-auto">

                                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "LoginUser", dir = "rtl", enctype = "multipart/form-data", @class = "mx-auto form-horizontal" }))
                                {
                                    <input id="ReturnUrl" type="hidden" value="@Model.ReturnUrl" />
                                    <input class="mb-3" type="text" tabindex="1" required placeholder="نام کاربری" name="PhoneNumber" id="PhoneNumber"/>
                                    <input class="mb-3" type="password" tabindex="2" required placeholder="کلمه عبور" name="Password" id="Password"/>
                                    <br/>
                                    <button type="submit" id="mobBtn" tabindex="3" class="btn btn-primary">ورود</button>
                                }
                                <div class="k-code-box">

                                </div>

                            </div>
                            <div>
                                @*<p>محصولی از <a href="#">شرکت نرم افزاری جادوی فکر(دانش بنیان)</a></p>*@
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 d-none d-lg-grid">
                        <div id="carouselExampleDark" class="carousel carousel-dark slide" data-bs-ride="carousel">
                            <div class="carousel-indicators">
                                <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="0" class="active"
                                        aria-current="true" aria-label="Slide 1"></button>
                                <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="1"
                                        aria-label="Slide 2"></button>
                                @*<button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="2"
                                        aria-label="Slide 3"></button>*@
                            </div>
                            <div class="carousel-inner">
                                <div class="carousel-item active" data-bs-interval="10000">
                                    <img src="~/asset/img/02.png" class="d-block" alt="login illustration">
                                    <div class="carousel-caption">
                                        <h5>خدمات آنلاین</h5>
                                        <p>کلیه امور اداری مربوط به عضویت در انجمن صنفی انبوه سازان بصورت انلاین و بدون مراجعه حضوری 
                                        در همین سامانه صورت می گیرد</p>
                                    </div>
                                </div>
                                <div class="carousel-item" data-bs-interval="2000">
                                    <img src="~/asset/img/01.png" class="d-block" alt="login illustration">
                                    <div class="carousel-caption">
                                        <h5>سرعت در پاسخگویی</h5>
                                        <p>پیگیری و پاسخگویی بصورت انلاین و اطلاع رسانی دقیق از اهداف این سامانه می باشد</p>
                                    </div>
                                </div>
                                @*<div class="carousel-item">
                                    <img src="~/asset/img/03.png" class="d-block" alt="login illustration">
                                    <div class="carousel-caption">
                                        <h5>پشتیبانی و ارائه خدمات</h5>
                                        <p>لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم از صنعت چاپ لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم از صنعت چاپ</p>
                                    </div>
                                </div>*@
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark"
                                    data-bs-slide="prev">
                                قبلی
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark"
                                    data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                                بعدی
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    



    <script src="~/asset/jquery/jquery.js"></script>
    <script src="~/asset/popper/popper-v2-11-2.js"></script>
    <script src="~/asset/bootstrap-5.1.3-dist/js/bootstrap.min.js"></script>
    <script src="~/js/sweetalert.min.js"></script>
    <script src="~/vendor/bootstrapvalidator/js/bootstrapValidator.js"></script>
    <script src="~/vendor/bootstrapvalidator/js/language/fa_IR.js"></script>
    <script src="~/asset/js/confirmCode.js"></script>
    <script src="~/vendor/toastr/toastr.min.js"></script>
    <script src="~/js/pages/account/login.js"></script>
</body>

</html>