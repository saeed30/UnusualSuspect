@using UnusualSuspect.ApiViewModels.InnerModels.PreGame
@model UnusualSuspect.ViewModels.PreGame.PreGameDetailsViewModel

@{
  ViewBag.Title = "جزئیات گروه " + Model.PreGameGroupGetResponse.PreGameGroupId;
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="toolbar" id="kt_toolbar">
  <div class="container-fluid d-flex flex-stack">
    <div class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
      <h1 class="d-flex align-items-center text-dark fw-bolder fs-3 my-1">@(ViewBag.Title)</h1>
    </div>
    <div class="d-flex align-items-center py-1">
      <a href="/PreGame" style="color:darkred;">بازگشت</a>
    </div>
  </div>
</div>
<div class="card card-flush">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h3>جزئیات گروه</h3>
        <div class="form-group row no-gutters">
          <label class="control-label col-md-3">زمان ایجاد</label>
          <div class="col-md-9">
            @Model.PreGameGroupGetResponse.CreatedTimeString
          </div>
        </div>
        <div class="form-group row no-gutters">
          <label class="control-label col-md-3">وضعیت گروه</label>
          <div class="col-md-9">
            @Model.PreGameGroupStatusTitle
          </div>
        </div>
        <div class="form-group row no-gutters">
          <label class="control-label col-md-3">نوع بازی</label>
          <div class="col-md-9">
            @Model.GameTypeTitle
          </div>
        </div>
        <div class="form-group row no-gutters">
          <label class="control-label col-md-3">تعداد اعضا (محاسبه شده)</label>
          <div class="col-md-9">
            @Model.PreGameGroupGetResponse.CalculatedJoinedUsers
          </div>
        </div>
        <div class="form-group row no-gutters">
          <label class="control-label col-md-3">کد بازی</label>
          <div class="col-md-9">
            @Model.PreGameGroupGetResponse.GameId
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <h3>اعضای گروه</h3>
        <table class="table">
          <thead>
            <tr>
              <td>کد کاربر</td>
              <td>نام کاربری</td>
              <td>نام مستعار</td>
              <td>زمان ورود به گروه</td>
              <td>آیا ایجاد کننده است</td>
              <td>وضعیت آمادگی جهت بازی</td>
            </tr>
          </thead>
          <tbody>
            @{
              foreach (JoinedPreGameDto dto in Model.PreGameGroupGetResponse.JoinedPreGame)
              {
                <tr>
                  <td>@dto.UserDto.Id</td>
                  <td>@dto.UserDto.Username</td>
                  <td>@dto.UserDto.NickName</td>
                  <td>@dto.JoinTimeString</td>
                  <td>@(dto.IsOwnerOfPreGroup ? "بله" : "خیر")</td>
                  <td>@dto.ReadyToGameStatus</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
