@using UnusualSuspect.Entities.GameModels
@{
  ViewBag.Title = "گروه های قبل بازی";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="toolbar" id="kt_toolbar">
  <div class="container-fluid d-flex flex-stack">
    <div class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
      <h1 class="d-flex align-items-center text-dark fw-bolder fs-3 my-1">@(ViewBag.Title)</h1>
    </div>
    <div class="d-flex align-items-center py-1">
    </div>
  </div>
</div>
<div class="card card-flush">
  <div class="card-body">
    @(Html.Kendo().Grid<PreGameGroup>()
        .Name("grid")
        .Columns(columns =>
        {
          columns.Bound(c => c.Id).Title("شناسه").Filterable(false);
          columns.Bound(c => c.GameType.Title).Title("نوع بازی");
          columns.Bound(c => c.PreGameGroupStatus.Title).Title("وضعیت بازی");
          columns.Bound(c => c.CreatedTimePersian).Title("زمان ایجاد");
          columns.Bound(c => c.ReadyToGameTimePersian).Title("زمان اعلام آمادگی برای شروع بازی");
          columns.Bound(c => c.CalculatedJoinedUsers).Title("تعداد فراد");
          columns.Bound(c => c.Id).Title("جزئیات گروه").ClientTemplate("<a href='/PreGame/Details/#=Id#'>جزئیات</a>");
          @*           columns.Bound(p => p.Id).ClientTemplate("<button data-modaltype='modal-lg'  type='button' class='k-button k-button-icontext EditItem' data-id='#=id#' data-type='0' data-remote='/HomeMenu/CreateEditMenuItem?homeMenuId=#=Id#'><i class='fas fa-edit text-primary'></i></button>").Title(" ").Filterable(false).Width(50);
          columns.Bound(p => p.Id).ClientTemplate("<button  data-id='#=Id#' type='button' class='k-button k-button-icontext DeleteItem' data-action='/HomeMenu/DeleteMenuItem' data-titlesweet='آیا مطمئن هستید' data-textsweet='در صورت اطمینان از حذف آیتم منو بر روی تائید کلیک کنید.' , SharedLocalizer['آیتم]' data-cancelbtn='انصراف' data-confirmbtn='تائید'><i class='fas fa-trash-alt text-danger'></i></button>").Title(" ").Filterable(false).Width(50);
 *@
        })
        .Pageable(pager => pager
        .Input(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        )
        .Filterable().Sortable()
        .DataSource(dataSource => dataSource
        .Ajax().Sort(a => a.Add("Id").Descending())
        .PageSize(20)
        .Model(model =>
        {
          model.Id(p => p.Id);

        })
        .Read(read => read.Action("ActivePregames_Read", "PreGame"))
        ))
  </div>
</div>