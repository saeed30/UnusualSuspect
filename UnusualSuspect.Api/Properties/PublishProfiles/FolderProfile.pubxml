    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>54e75e39-d3fb-4271-a3e8-29ea14c6e5be</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
