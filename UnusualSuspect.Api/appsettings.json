{
  "IsTesting": true,
  "RateLimiterSetting": {
    "AuthenticatedUserRequestPeriodInSeconds": 60,
    "AuthenticatedUserAllowedRequestCount": 1000,
    "AnonymousUserRequestPeriodInSeconds": 60,
    "AnonymousUserAllowedRequestCount": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer", "Serilog.Enrichers.ClientInfo" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "RequestLoggingOptions": {
      "GetLevel": "(httpContext, elapsed, ex) => elapsed.TotalMilliseconds > 1000 ? LogEventLevel.Warning : LogEventLevel.Information",
      "MessageTemplate": "{RequestMethod} {RequestPath} responded {StatusCode} in {Elapsed:0.0000} ms",
      "EnrichDiagnosticContext": "(diagnosticContext, httpContext) => diagnosticContext.Set(&quot;User&quot;, httpContext.User.Identity.Name)"
    },
    "Enrich": [
      "FromLogContext",
      "WithClientIp",
      {
        "Name": "WithRequestHeader",
        "Args": {
          "headerName": "User-Agent"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "SerilogConnectionString",
          "tableName": "Serilogs",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "EventTypeId",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "DataKey",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "ExtraInfo",
                "DataType": "nvarchar"
              },
              {
                "ColumnName": "UserName",
                "DataType": "nvarchar",
                "DataLength": 500
              },
              {
                "ColumnName": "ClientIp",
                "DataType": "nvarchar",
                "DataLength": 100
              },
              {
                "ColumnName": "UserAgent",
                "DataType": "nvarchar",
                "DataLength": 500
              },
              {
                "ColumnName": "ActionId",
                "DataType": "nvarchar",
                "DataLength": 100
              },
              {
                "ColumnName": "ActionName",
                "DataType": "nvarchar"
              },
              {
                "ColumnName": "RequestId",
                "DataType": "nvarchar",
                "DataLength": 100
              },
              {
                "ColumnName": "RequestPath",
                "DataType": "nvarchar"
              },
              {
                "ColumnName": "SourceContext",
                "DataType": "nvarchar"
              }
            ],
            "properties": {
              "columnName": "Properties",
              "excludeAdditionalProperties": true,
              "dictionaryElementName": "dict",
              "itemElementName": "item",
              "omitDictionaryContainerElement": false,
              "omitSequenceContainerElement": false,
              "omitStructureContainerElement": false,
              "omitElementIfEmpty": true,
              "propertyElementName": "prop",
              "rootElementName": "root",
              "sequenceElementName": "seq",
              "structureElementName": "struct",
              "usePropertyKeyAsElementName": false
            },
            "LogEvent": {
              "excludeAdditionalProperties": true,
              "excludeStandardColumns": true
            }
          }
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/log.json",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationConnectionString": "data source=DESKTOP-VD3KFUT\\MSSQLSERVER2022;initial catalog=GameDb;user id=sa;password=123;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "ElmahConnectionString": "data source=DESKTOP-VD3KFUT\\MSSQLSERVER2019;initial catalog=ElmahDb;user id=sa;password=123;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "HangfireConnectionString": "data source=DESKTOP-VD3KFUT\\MSSQLSERVER2019;initial catalog=HangfireDb;user id=sa;password=123;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "SerilogConnectionString": "data source=DESKTOP-VD3KFUT\\MSSQLSERVER2019;initial catalog=SerilogDb;user id=sa;password=123;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "IdentitySettings": {
    "PasswordRequireDigit": "false",
    "PasswordRequiredLength": "0",
    "PasswordRequireNonAlphanumeric": "false",
    "PasswordRequireUppercase": "false",
    "PasswordRequireLowercase": "false",
    "RequireUniqueEmail": "false"
  },
  "JwtSettings": {
    //"SecretKey": "LongerThan-16Char-SecretKey",
    //"EncryptKey": "16CharEncryptKey",
    "SecretKey": "edf52b6160e3b8ab26a57d1490e11599457cf3a00575e264",
    "EncryptKey": "d33e1f72052f3e92",
    "Issuer": "MyWebsite",
    "Audience": "MyWebsite",
    "NotBeforeMinutes": "0",
    "ExpirationMinutes": "6000"
  },
  "SiteSetting": {
    "ElmahPath": "/elmah-errors",
    "SiteUrl": "http://localhost:8585/",
    "EngineerImagePath": "api/Engineer/Image?id=",
    "UserImagePath": "api/User/Image?id=",
    "Privacy": "",
    "AppVersion": "1.1",
    "PasswordOptions": {
      "RequireDigit": false,
      "RequiredLength": 6,
      "RequireLowercase": false,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false
    },
    "CookieOptions": {
      "AccessDeniedPath": "/Error/Index/401",
      "CookieName": ".ASPNETCoreIdentity.Sample",
      "ExpireTimeSpan": "15.00:00:00.0000",
      "LoginPath": "/Account/login",
      "LogoutPath": "/Account/LogOff",
      "SlidingExpiration": true,
      "UseDistributedCacheTicketStore": true,
      "DistributedSqlServerCacheOptions": {
        "ConnectionString": "",
        "TableName": "AppSqlCache",
        "SchemaName": "dbo"
      },
      "DistributedSqliteCacheOptions": {
        "ConnectionString": "Data Source=|DataDirectory|\\cache.sqlite"
      }
    }
  },
  "HangfireSetting": {
    "AdminUsername": "",
    "AdminPassword": ""
  },
  "FireBaseSetting": {
    "FireBaseToken": "",
    "FCMChannelName": "/topics/all",
    "FCMToken": ""
  },
  "AdminUser": {
    "Username": "admin",
    "Password": "12345",
    "Email": "admin@site.com",
    "RoleName": "Admin"
  },
  "GameSetting": {
    "TimeToTalkInSeconds": 60
  }
}
